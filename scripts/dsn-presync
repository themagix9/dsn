#!/usr/bin/env python3
"""rsync pre-xfer-Hook: lehnt eingehende Syncs ab, wenn der Service auf diesem Node gerade läuft.

Schützt davor, dass ein veralteter Node die aktiven Daten eines laufenden Services überschreibt.
"""
import os
import sys
import urllib.request

req = os.environ.get("RSYNC_REQUEST", "")          # z.B. "volumes/nextcloud/"
parts = [p for p in req.split("/") if p]
if len(parts) < 2:
    sys.exit(1)
svc = parts[1]
url = f"http://{os.environ.get('DSN_API', '127.0.0.1:7946')}/internal/accept_sync?service={svc}"
r = urllib.request.Request(url, headers={"Authorization": f"Bearer {os.environ.get('DSN_SECRET', '')}"})
try:
    with urllib.request.urlopen(r, timeout=5) as resp:
        sys.exit(0 if resp.status == 200 else 1)
except Exception as e:  # noqa: BLE001
    print(f"dsn-presync: Sync für {svc} abgelehnt: {e}", file=sys.stderr)
    sys.exit(1)
